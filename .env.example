# ChruBG Environment Configuration
# Copy or rename to .env for local/server use.

# Port to run the local server on (default: 8000)
# PORT=8000

# Additional custom domains allowed to probe and use the server-side video backend (comma-separated)
# e.g.: ALLOWED_SERVER_HOSTS=mycustomdomain.com,video.internal.company.com
ALLOWED_SERVER_HOSTS=

# Maximum video upload size in megabytes (default: 200)
# MAXIMUM_VIDEO_UPLOAD_MEGABYTES=200

# Maximum video duration in seconds for server processing (default: 60)
# MAXIMUM_VIDEO_SECONDS=60

# Longest side in pixels for processing (default: 960)
# MAXIMUM_VIDEO_SIDE_IN_PIXELS=960
