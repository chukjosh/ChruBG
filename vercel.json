{
  "buildCommand": "python3 scripts/download_model.py",
  "outputDirectory": "public",
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Cross-Origin-Opener-Policy",
          "value": "same-origin"
        },
        {
          "key": "Cross-Origin-Embedder-Policy",
          "value": "require-corp"
        }
      ]
    }
  ],
  "functions": {
    "api/remove_background.py": {
      "maxDuration": 60,
      "includeFiles": "models/**",
      "excludeFiles": "{public/**,tests/**,.github/**,scripts/**,local_server.py,local_video.py,Dockerfile,*.md}"
    }
  }
}
